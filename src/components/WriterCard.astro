---
import Avatar from "@/components/ui/Avatar.astro";
import { writerBio } from "@/config/writers";
import type { WriterSummary } from "@/lib/issues";

interface Props {
  writer: WriterSummary;
  showBio?: boolean;
}

const { writer, showBio = false } = Astro.props;
const bio = writerBio(writer.name);
const count = writer.issues.length;
---

<a class="writer-card" href={`/writers/${writer.slug}/`}>
  <Avatar name={writer.name} size={showBio ? "lg" : "md"} />
  <span class="stack" style="gap:0.3rem">
    <span class="t-h4">{writer.name}</span>
    <span class="t-meta">
      {writer.role} &middot; {count} {count === 1 ? "issue" : "issues"}
    </span>
    {showBio && bio && <span class="t-small t-dim" style="margin-top:0.25rem">{bio}</span>}
  </span>
</a>
