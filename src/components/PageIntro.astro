---
interface Props {
  title: string;
  description?: string;
  note?: string;
}

const { title, description, note } = Astro.props;
---

<div class="page-intro">
  <h1 class="t-h1">{title}</h1>
  {description && <p class="t-lead">{description}</p>}
  {note && <p class="t-meta">{note}</p>}
  <slot />
</div>
