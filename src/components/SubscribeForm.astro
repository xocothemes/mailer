---
import { siteConfig } from "@/config/site";

/**
 * The signup form. Until `newsletter.action` is set the field renders disabled
 * rather than posting nowhere, so a theme that has not been wired up yet never
 * silently eats an address.
 */
interface Props {
  id: string;
  buttonLabel?: string;
  showTerms?: boolean;
  class?: string;
}

const { id, buttonLabel = "Subscribe", showTerms = true, class: className = "" } = Astro.props;

const { newsletter } = siteConfig;
const action = newsletter.action.trim();
const configured = newsletter.enabled && action.length > 0;
const noteId = `${id}-note`;
---

<form
  class:list={["signup", className]}
  action={configured ? action : undefined}
  method={newsletter.method || "post"}
  aria-describedby={noteId}
>
  <div class="signup__row">
    <div class="field">
      <label class="sr-only" for={id}>Email address</label>
      <input
        id={id}
        class="field__input"
        type="email"
        name={newsletter.emailFieldName || "email"}
        autocomplete="email"
        placeholder="you@example.com"
        required
        disabled={!configured}
      />
    </div>
    <button type="submit" class="btn" disabled={!configured}>{buttonLabel}</button>
  </div>

  <p id={noteId} class:list={["signup__note", !showTerms && "sr-only"]}>
    {
      configured
        ? [siteConfig.cadence, newsletter.proof, newsletter.terms].filter(Boolean).join(" · ")
        : "Signup is disabled until a provider is configured in src/config/site.ts."
    }
  </p>
</form>
