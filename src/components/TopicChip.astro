---
import { topicSlug, type Topic } from "@/config/topics";

interface Props {
  topic: Topic;
  linked?: boolean;
  count?: number;
  class?: string;
}

const { topic, linked = true, count, class: className = "" } = Astro.props;
const slug = topicSlug(topic);
const classes = ["chip", className];
---

{
  linked ? (
    <a class:list={classes} data-topic={slug} href={`/topics/${slug}/`}>
      {topic}
      {typeof count === "number" && <span class="chip__count">{count}</span>}
    </a>
  ) : (
    <span class:list={classes} data-topic={slug}>
      {topic}
      {typeof count === "number" && <span class="chip__count">{count}</span>}
    </span>
  )
}
