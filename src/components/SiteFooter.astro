---
import LocalIcon from "@/components/LocalIcon.astro";
import { footerNavigation, siteConfig } from "@/config/site";
import { socialIconFor } from "@/lib/socials";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="t-h4">{siteConfig.name}</p>
        <p class="t-small t-dim">{siteConfig.bio}</p>
      </div>

      {
        footerNavigation.map((column) => (
          <nav class="footer-col" aria-labelledby={`footer-${column.title.toLowerCase()}`}>
            <h2 id={`footer-${column.title.toLowerCase()}`}>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {siteConfig.name}. Built with Astro.</p>

      <div class="social-row">
        {
          siteConfig.socials.map((social) => (
            <a
              class="icon-btn"
              href={social.href}
              rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              <LocalIcon name={socialIconFor(social.label)} size={16} />
              <span class="sr-only">{social.label}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
