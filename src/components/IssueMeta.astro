---
import Avatar from "@/components/ui/Avatar.astro";
import { formatDate, readMinutes, writerSlug, type Issue } from "@/lib/issues";

/**
 * "Mara Chen · Sep 17, 2026 · 6 min read" — the same line on a card, an index
 * row, and an article, so a reader scanning the page reads one rhythm.
 */
interface Props {
  issue: Issue;
  showWriter?: boolean;
  showReadTime?: boolean;
  /** Links the writer's name. Off inside a card, where the whole block is a link. */
  linked?: boolean;
  class?: string;
}

const {
  issue,
  showWriter = true,
  showReadTime = true,
  linked = false,
  class: className = "",
} = Astro.props;
const { author, date } = issue.data;
const Name = linked ? "a" : "span";
---

<p class:list={["meta", className]}>
  {
    showWriter && (
      <Name class="meta__author" {...(linked ? { href: `/writers/${writerSlug(author.name)}/` } : {})}>
        <Avatar name={author.name} size="sm" />
        {author.name}
      </Name>
    )
  }
  {showWriter && <span class="dot-sep" aria-hidden="true" />}
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  {showReadTime && <span class="dot-sep" aria-hidden="true" />}
  {showReadTime && <span>{readMinutes(issue)} min read</span>}
</p>
