---
import Icon from "@/components/ui/Icon.astro";

/** A download: a template, a spreadsheet, the data behind a chart. */
interface Props {
  /** A file in `public/`, or any absolute URL. */
  src: string;
  title: string;
  caption?: string;
  /** "PDF · 240 KB". Written out rather than measured, so it stays honest. */
  meta?: string;
}

const { src, title, caption, meta } = Astro.props;
---

<a class="file-card" href={src} download>
  <span class="file-card__icon" aria-hidden="true">
    <Icon name="file" size={18} />
  </span>
  <span class="file-card__body">
    <span class="file-card__title">{title}</span>
    {caption && <span class="file-card__caption">{caption}</span>}
    {meta && <span class="file-card__meta">{meta}</span>}
  </span>
</a>
