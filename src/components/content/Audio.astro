---
/**
 * An audio file with the browser's own player. The native controls are
 * keyboard accessible, follow the operating system's media keys, and cost
 * nothing to ship, which a custom player cannot claim.
 */
interface Props {
  /** A file in `public/`, or any absolute URL. */
  src: string;
  title: string;
  /** Printed under the title. "3:12", "Read by the author". */
  note?: string;
}

const { src, title, note } = Astro.props;
---

<figure class="media">
  <p class="media__title">{title}</p>
  {note && <p class="media__note">{note}</p>}
  <audio controls preload="none" src={src}>
    <a href={src}>Download the audio</a>
  </audio>
</figure>
