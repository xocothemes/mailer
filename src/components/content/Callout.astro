---
/**
 * A short aside set off from the prose. Each tone is mixed from the theme's
 * own tokens rather than a fixed pastel, so it holds in both colour modes
 * instead of glowing on a dark page.
 */
interface Props {
  /** Grey separates, accent is the brand, the rest carry their usual meaning. */
  tone?: "grey" | "accent" | "info" | "success" | "warn" | "danger";
  /** A single character. Leave it out for a callout with no mark. */
  emoji?: string;
}

const { tone = "grey", emoji } = Astro.props;
---

<aside class:list={["callout", `callout--${tone}`]}>
  {
    emoji && (
      <span class="callout__mark" aria-hidden="true">
        {emoji}
      </span>
    )
  }
  <div class="callout__body"><slot /></div>
</aside>
