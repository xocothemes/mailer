---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { lightboxRendition } from "@/lib/images";

/**
 * One picture inside an issue, with an optional caption and a
 * click-to-enlarge view.
 *
 * `wide` lets a picture break out of the reading column to a comfortable
 * picture width — the one place an issue page is allowed to be wider than its
 * text.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  creditUrl?: string;
  width?: "regular" | "wide";
  /**
   * Lightbox group. Every picture in the body shares one by default, so the
   * arrows walk the whole piece in reading order.
   */
  group?: string;
}

const {
  src,
  alt,
  caption,
  credit,
  creditUrl,
  width = "regular",
  group = "issue",
} = Astro.props;

const full = await lightboxRendition(src);
const sizes = width === "wide" ? "(min-width: 64rem) 58rem, 92vw" : "(min-width: 44rem) 42rem, 92vw";
---

<figure class:list={["figure", width === "wide" && "figure--wide"]}>
  <button
    class="figure__frame"
    type="button"
    data-lightbox
    data-lightbox-group={group}
    data-lightbox-src={full.src}
    data-lightbox-srcset={full.srcSet.attribute}
    data-lightbox-alt={alt}
    data-lightbox-caption={caption ?? ""}
    data-lightbox-credit={credit ?? ""}
    aria-label={`Enlarge: ${alt}`}
  >
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, 1800]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
  </button>

  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {caption && credit && " "}
        {credit &&
          (creditUrl ? (
            <a class="link" href={creditUrl} rel="noopener noreferrer">
              {credit}
            </a>
          ) : (
            credit
          ))}
      </figcaption>
    )
  }
</figure>
