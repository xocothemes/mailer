---
import Icon from "@/components/ui/Icon.astro";

/**
 * Detail a reader can ask for: a long caveat, a worked example, the answer to
 * a question only some subscribers have. Several in a row read as a short FAQ,
 * and each opens on its own.
 *
 * Built on `<details>`, so it works with no JavaScript and is found by the
 * browser's own in-page search.
 */
interface Props {
  heading: string;
  /** Open on load. Useful for the first of a run. */
  open?: boolean;
}

const { heading, open = false } = Astro.props;
---

<details class="toggle" open={open}>
  <summary>
    <span>{heading}</span>
    <Icon name="chevron-down" size={18} />
  </summary>
  <div class="toggle__body"><slot /></div>
</details>
