---
/**
 * The two things an issue body needs that no component can provide.
 *
 * A Markdown table carries no classes of its own, so each one is given a frame
 * to scroll inside: four columns do not fit a phone, and an overflowing table
 * drags the whole page sideways with it. The frame is focusable, which a bare
 * overflow container is not, so it can be scrolled from the keyboard.
 *
 * Images written as plain Markdown get the same click-to-enlarge treatment a
 * `Figure` has, so a writer who never reaches for a component still gets the
 * lightbox.
 */
---

<script>
  document.querySelectorAll<HTMLTableElement>(".prose table").forEach((table) => {
    if (table.closest(".table-scroll")) return;

    const frame = document.createElement("div");
    frame.className = "table-scroll";
    frame.tabIndex = 0;
    frame.setAttribute("role", "region");
    frame.setAttribute("aria-label", table.caption?.textContent?.trim() || "Table");

    table.replaceWith(frame);
    frame.append(table);
  });

  document.querySelectorAll<HTMLImageElement>(".prose > p > img, .prose > img").forEach((image) => {
    image.dataset.lightbox = "";
    image.dataset.lightboxGroup = "issue";
    image.dataset.lightboxSrc = image.currentSrc || image.src;
    image.dataset.lightboxAlt = image.alt;
    image.style.cursor = "zoom-in";
  });
</script>
