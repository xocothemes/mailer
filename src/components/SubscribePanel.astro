---
import SubscribeForm from "@/components/SubscribeForm.astro";
import { siteConfig } from "@/config/site";

interface Props {
  id: string;
  title?: string;
  description?: string;
}

const {
  id,
  title = siteConfig.newsletter.title,
  description = siteConfig.newsletter.description,
} = Astro.props;
---

<aside class="panel panel--accent subscribe-panel" aria-labelledby={`${id}-title`}>
  <div class="stack" style="gap:0.75rem">
    <h2 class="t-h2" id={`${id}-title`}>{title}</h2>
    <p class="t-lead">{description}</p>
  </div>
  <SubscribeForm id={`${id}-email`} />
</aside>

<style>
  .subscribe-panel {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .subscribe-panel {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
