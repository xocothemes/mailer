---
import ShareSheet from "@/components/ShareSheet.astro";
import LocalIcon from "@/components/LocalIcon.astro";

/**
 * The share control on an issue. One button, which hands off to the device's
 * own share sheet where there is one and opens `ShareSheet` everywhere else.
 */
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---

<div class="share">
  <span class="t-meta">Share</span>
  <button
    type="button"
    class="btn btn--outline btn--sm"
    data-share-open
    data-share-title={title}
    data-share-url={url}
  >
    <LocalIcon name="share" size={14} />
    <span>Share this issue</span>
  </button>
</div>

<ShareSheet title={title} url={url} />

<script>
  /* The native sheet is offered first, and only where it exists. `canShare`
     rather than `share` alone: some desktop browsers expose `share` and then
     reject every call, which would swallow the click. */
  document.querySelectorAll<HTMLButtonElement>("[data-share-open]").forEach((button) => {
    button.addEventListener(
      "click",
      async (event) => {
        const data = {
          title: button.dataset.shareTitle ?? document.title,
          url: button.dataset.shareUrl ?? window.location.href,
        };

        if (!navigator.canShare?.(data)) return;

        event.stopImmediatePropagation();
        try {
          await navigator.share(data);
        } catch {
          /* Dismissed, or refused. The card in the page is still there. */
        }
      },
      { capture: true },
    );
  });
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
</style>
