---
import { getImage } from "astro:assets";
import { writerProfile } from "@/config/writers";
import { writerInitials } from "@/lib/issues";

interface Props {
  name: string;
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}

const { name, size = "sm", class: className = "" } = Astro.props;

/**
 * Portraits render as a background image: they are decorative — the byline
 * beside them carries the name — never larger than 80px, and the same handful
 * of files is reused site-wide, so there is no responsive sizing to do.
 */
const profile = writerProfile(name);
const pixels = { sm: 24, md: 40, lg: 56, xl: 80 }[size];
const rendered = profile
  ? await getImage({ src: profile.image, width: pixels * 2, height: pixels * 2, format: "webp" })
  : null;
---

<span
  class:list={["avatar", `avatar--${size}`, className]}
  aria-hidden="true"
  style={rendered ? `background-image:url("${rendered.src}")` : undefined}
>
  {!rendered && writerInitials(name)}
</span>
