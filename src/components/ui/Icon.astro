---
/** Stroked UI icons on a 24x24 grid. Social and brand marks come from LocalIcon. */
export type IconName =
  | "arrow-right"
  | "arrow-left"
  | "search"
  | "sun"
  | "moon"
  | "menu"
  | "close"
  | "chevron-down"
  | "file"
  | "external-link";

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = "", size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow-right" && <path d="M5 12h13m-6-6 6 6-6 6" />}
  {name === "arrow-left" && <path d="M19 12H6m6-6-6 6 6 6" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {
    name === "external-link" && (
      <>
        <path d="M15 4h5v5M11 13 20 4" />
        <path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" />
      </>
    )
  }
  {
    name === "file" && (
      <>
        <path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5Z" />
        <path d="M13.5 3v5.5H19" />
      </>
    )
  }
  {name === "moon" && <path d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z" />}
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16.5 16.5 4 4" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" />
      </>
    )
  }
</svg>
