---
import IssueMeta from "@/components/IssueMeta.astro";
import TopicChip from "@/components/TopicChip.astro";
import { formatYear, issueHref, issueNumber, type Issue } from "@/lib/issues";

/**
 * The archive as a numbered ledger rather than a grid of cards: the shape a
 * reader already expects from a newsletter that counts its issues.
 */
interface Props {
  issues: Issue[];
  /** Prints a year rule whenever the year changes. Off inside a topic page. */
  groupByYear?: boolean;
  showExcerpt?: boolean;
  headingLevel?: "h2" | "h3";
}

const { issues, groupByYear = false, showExcerpt = true, headingLevel: Heading = "h3" } =
  Astro.props;

const rows = issues.map((issue, index) => ({
  issue,
  year: formatYear(issue.data.date),
  isNewYear:
    groupByYear &&
    (index === 0 || formatYear(issue.data.date) !== formatYear(issues[index - 1].data.date)),
}));
---

<div class="index">
  {
    rows.map(({ issue, year, isNewYear }) => (
      <>
        {isNewYear && <p class="index__year t-number">{year}</p>}
        <a class="index__row" href={issueHref(issue)}>
          <span class="index__no">{issueNumber(issue)}</span>

          <div class="index__main">
            <Heading class="index__title">{issue.data.title}</Heading>
            {showExcerpt && <p class="index__excerpt">{issue.data.excerpt}</p>}
          </div>

          {/* One row on a phone, two grid cells on a wide screen — the wrapper
              becomes `display: contents` there. */}
          <span class="index__facts">
            <span class="index__topic">
              <TopicChip topic={issue.data.topic} linked={false} />
            </span>

            <IssueMeta issue={issue} showWriter={false} class="index__meta" />
          </span>
        </a>
      </>
    ))
  }
</div>
