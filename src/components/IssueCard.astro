---
import { Image } from "astro:assets";
import IssueMeta from "@/components/IssueMeta.astro";
import TopicChip from "@/components/TopicChip.astro";
import { issueHref, issueNumber, type Issue } from "@/lib/issues";

interface Props {
  issue: Issue;
  headingLevel?: "h2" | "h3";
  showExcerpt?: boolean;
  eager?: boolean;
}

const { issue, headingLevel: Heading = "h3", showExcerpt = true, eager = false } = Astro.props;
const { title, excerpt, cover, topic } = issue.data;
---

<article class="card">
  <a class="card__media" href={issueHref(issue)} tabindex="-1" aria-hidden="true">
    <Image
      src={cover.src}
      alt=""
      widths={[320, 480, 720]}
      sizes="(min-width: 62rem) 22rem, (min-width: 40rem) 45vw, 92vw"
      loading={eager ? "eager" : "lazy"}
      decoding={eager ? "sync" : "async"}
    />
  </a>

  <div class="stack" style="gap:0.6rem">
    <div class="meta">
      <TopicChip topic={topic} linked={false} />
      <span class="t-number">No. {issueNumber(issue)}</span>
    </div>

    <Heading class="card__title">
      <a href={issueHref(issue)}>{title}</a>
    </Heading>

    {showExcerpt && <p class="card__excerpt">{excerpt}</p>}

    <IssueMeta issue={issue} showReadTime={false} />
  </div>
</article>
