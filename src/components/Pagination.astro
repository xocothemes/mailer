---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  prevUrl?: string;
  nextUrl?: string;
  currentPage: number;
  lastPage: number;
  label: string;
}

const { prevUrl, nextUrl, currentPage, lastPage, label } = Astro.props;
---

{
  lastPage > 1 && (
    <nav class="pagination" aria-label={label}>
      {prevUrl ? (
        <a class="btn btn--outline" href={prevUrl} rel="prev">
          <Icon name="arrow-left" size={15} />
          Newer
        </a>
      ) : (
        <span />
      )}

      <p class="pagination__state">
        Page {currentPage} of {lastPage}
      </p>

      {nextUrl ? (
        <a class="btn btn--outline" href={nextUrl} rel="next">
          Older
          <Icon name="arrow-right" size={15} />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
