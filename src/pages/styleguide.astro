---
import { Code } from "astro:components";
import Audio from "@/components/content/Audio.astro";
import Bookmark from "@/components/content/Bookmark.astro";
import Callout from "@/components/content/Callout.astro";
import Figure from "@/components/content/Figure.astro";
import FileCard from "@/components/content/FileCard.astro";
import Lightbox from "@/components/content/Lightbox.astro";
import ProseRuntime from "@/components/content/ProseRuntime.astro";
import Toggle from "@/components/content/Toggle.astro";
import PageIntro from "@/components/PageIntro.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { codeDefaultColor, codeThemes } from "@/config/code";

import wide from "@/content/issues/deliverability-without-the-folklore/photo-1.jpg";
import regular from "@/content/issues/plain-text-still-beats-your-template/photo-1.jpg";

/**
 * Every block an issue can carry, in the reading column an issue uses — so a
 * card here reads exactly as it will in a published issue.
 *
 * Copy the markup straight out of this page's source when you write your own:
 * each block below is the component, its props, and nothing else. In an MDX
 * issue the imports are unnecessary, because `src/lib/issue-components.ts`
 * hands the whole set to MDX already.
 */
---

<BaseLayout
  title="Styleguide"
  description="Every block an issue can carry, styled by the theme."
  noindex
>
  <SiteHeader />

  <main id="content">
    <div class="reading">
      <PageIntro
        title="Styleguide"
        description="Every block an issue can carry, styled by the theme. Open this page's source to see how each one is written."
      />
    </div>

    <section class="reading section--tight">
      <div class="prose">
        <h1>Heading one</h1>
        <h2>Heading two</h2>
        <h3>Heading three</h3>
        <h4>Heading four</h4>

        <h2>Text</h2>
        <p>
          Body copy sits at the reading measure the issue pages use. It carries <strong>bold</strong
          > and <em>italic</em> emphasis, <code>inline code</code>, and <a href="https://astro.build">links</a> that pick up the accent colour.
        </p>

        <h2>Quotes</h2>
        <blockquote>
          <p>A smaller list that gets opened is worth more than a big one that gets ignored.</p>
        </blockquote>

        <h2>Lists</h2>
        <ul>
          <li>Unordered items wrap against a hanging indent</li>
          <li>Spacing matches the body rhythm</li>
          <li>Nesting is styled two levels deep</li>
        </ul>
        <ol>
          <li>Numbered lists share the same measure</li>
          <li>The counter sits outside the text column</li>
          <li>Long items stay aligned</li>
        </ol>

        <h2>Tables</h2>
        <p>
          A table scrolls inside its own frame when a narrow screen cannot hold it, so it never
          drags the page sideways.
        </p>
        <table>
          <thead>
            <tr>
              <th>Metric</th>
              <th>Template</th>
              <th>Near-plain</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Open rate</td>
              <td>41.2%</td>
              <td>43.8%</td>
            </tr>
            <tr>
              <td>Click rate</td>
              <td>3.1%</td>
              <td>4.9%</td>
            </tr>
            <tr>
              <td>Replies per issue</td>
              <td>6</td>
              <td>19</td>
            </tr>
          </tbody>
        </table>

        <h2>Code</h2>
        <p>
          A fenced block is highlighted at build time, with one set of colours for each mode and no
          highlighter shipped to the reader.
        </p>
        <Code
          code={`<body style="margin: 0; padding: 24px 16px; background: #fff">
  <div style="max-width: 560px; margin: 0 auto; font: 16px/1.6 system-ui, sans-serif">
    <!-- the issue -->
  </div>
</body>`}
          lang="html"
          themes={codeThemes}
          defaultColor={codeDefaultColor}
        />

        <h2>Pictures</h2>
        <p>A regular figure sits at the width of the reading column.</p>
        <Figure
          src={regular}
          alt="A gradient of blue, cyan and lilac"
          caption="Regular width. Click it to open the lightbox."
          credit="Photo by Codioful"
          creditUrl="https://www.pexels.com/photo/a-blue-color-gradient-7135014/"
          group="styleguide"
        />
        <p>A wide figure breaks out of the column to a comfortable picture width.</p>
        <Figure
          src={wide}
          alt="A soft gradient of cream, peach and coral"
          caption="Wide."
          credit="Photo by Codioful"
          creditUrl="https://www.pexels.com/photo/a-light-color-gradient-7130554/"
          width="wide"
          group="styleguide"
        />

        <h2>Callouts</h2>
        <Callout tone="grey">
          <p>Grey is the quiet one, for a note that only needs separating from the prose.</p>
        </Callout>
        <Callout tone="accent">
          <p>Accent takes the theme's own colour.</p>
        </Callout>
        <Callout tone="info" emoji="💡">
          <p>Info reads as background: a definition, a piece of context, a link worth following.</p>
        </Callout>
        <Callout tone="success" emoji="✓">
          <p>Success is for the thing that worked, or the setting you want confirmed.</p>
        </Callout>
        <Callout tone="warn" emoji="⚠️">
          <p>Warn is the caution, for a caveat a reader should not miss.</p>
        </Callout>
        <Callout tone="danger" emoji="⛔">
          <p>Danger is for the mistake that costs a list — an unauthenticated send, say.</p>
        </Callout>

        <h2>Toggles</h2>
        <Toggle heading="A toggle hides detail until it is asked for" open>
          <p>
            Useful for a long caveat, a worked example, or the answer to a question only some
            subscribers have.
          </p>
        </Toggle>
        <Toggle heading="Several can sit together as a short FAQ">
          <p>Each one opens on its own, so a reader can take only the part they came for.</p>
        </Toggle>

        <h2>Bookmarks</h2>
        <p>
          A bookmark only needs a URL. The picture, the title and the description are read from the
          linked page's own Open Graph tags at build time, and a page that has none falls back to a
          plain card.
        </p>
        <Bookmark url="https://astro.build/" />
        {/* example.com carries no Open Graph tags at all, so this is the real
            fallback rather than a card pretending to be one. */}
        <Bookmark
          url="https://example.com/"
          title="A page with no Open Graph tags"
          description="With nothing to show, the card stays a plain row and falls back to the link's own host."
        />

        <h2>Audio</h2>
        <Audio
          src="/media/sample-audio.wav"
          title="A sample recording"
          note="Three seconds, for the shape of the player."
        />

        <h2>Files</h2>
        <FileCard
          src="/files/sample-document.pdf"
          title="A sample document"
          caption="What a downloadable template or data set looks like in the reading column."
          meta="PDF · 1 KB"
        />
      </div>

      <ProseRuntime />
    </section>
  </main>

  <Lightbox />
  <SiteFooter />
</BaseLayout>
