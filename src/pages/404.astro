---
import { getCollection } from "astro:content";
import IssueIndex from "@/components/IssueIndex.astro";
import SectionHead from "@/components/SectionHead.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { publishedIssues } from "@/lib/issues";

const issues = publishedIssues(await getCollection("issues"));
const recent = issues.slice(0, 4);
---

<BaseLayout title="Page not found" description="That page could not be found." noindex>
  <SiteHeader />
  <main id="content">
    <div class="container">
      <div class="notfound">
        <p class="t-meta t-number">404</p>
        <h1 class="t-display">This one never went out.</h1>
        <p class="t-lead">
          The issue may have been renumbered, or the link may be mistyped. The archive has
          everything.
        </p>
        <div class="notfound__actions">
          <a class="btn btn--lg" href="/archive/">Browse the archive</a>
          <a class="btn btn--outline btn--lg" href="/">Front page</a>
        </div>
      </div>

      <section class="section--tight" aria-labelledby="notfound-recent">
        <SectionHead title="Most recent issues" id="notfound-recent" href="/archive/" />
        <IssueIndex issues={recent} headingLevel="h3" />
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 42rem;
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3rem);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }
</style>
