---
import PageIntro from "@/components/PageIntro.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
---

<BaseLayout title="Privacy" description={`Privacy policy for ${siteConfig.name}.`}>
  <SiteHeader />
  <main id="content">
    <div class="reading">
      <PageIntro
        title="Privacy"
        description="A starting point, not legal advice. Replace it with a policy that describes what your own setup actually does."
      />
    </div>

    <section class="reading section--tight">
      <div class="prose">
        <h2>What is collected</h2>
        <p>
          If you subscribe, your email address is stored by the newsletter provider configured for
          this site, so the newsletter can be sent to you. Nothing else is required.
        </p>

        <h2>How it is used</h2>
        <p>
          To send the newsletter, to answer you if you write in, and to meet legal obligations.
          Addresses are never sold or traded.
        </p>

        <h2>Analytics</h2>
        <p>
          This theme ships with no analytics and no third-party scripts. Anything you add is yours
          to disclose here.
        </p>

        <h2>Removing your data</h2>
        <p>
          Every issue carries a one-click unsubscribe link, which removes the address from the
          sending list. For anything else, write to{" "}
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
