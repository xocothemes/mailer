---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageIntro from "@/components/PageIntro.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SubscribePanel from "@/components/SubscribePanel.astro";
import Avatar from "@/components/ui/Avatar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import aboutImage from "@/assets/site/about.jpg";
import { siteConfig } from "@/config/site";
import { writerBio } from "@/config/writers";
import { allWriters, formatDate, publishedIssues, writerSlug } from "@/lib/issues";

const issues = publishedIssues(await getCollection("issues"));
const editor = allWriters(issues).find((writer) => writer.name === siteConfig.editor.name);
const first = issues.at(-1);
---

<BaseLayout title="About" description={`What ${siteConfig.name} is, who writes it, and how often it arrives.`}>
  <SiteHeader />
  <main id="content">
    <div class="container">
      <PageIntro
        title={`About ${siteConfig.name}`}
        description={siteConfig.bio}
        note={first ? `Sending since ${formatDate(first.data.date, "long")}` : undefined}
      />
    </div>

    <div class="container">
      <figure class="about-figure">
        <Image
          src={aboutImage}
          alt="A wall of numbered apartment mailboxes"
          widths={[720, 1080, 1600]}
          sizes="(min-width: 72rem) 68rem, 92vw"
          loading="eager"
        />
        <figcaption class="credit">
          Photograph by{" "}
          <a class="link" href="https://www.pexels.com/photo/bright-yellow-apartment-mailboxes-front-view-13209666/" rel="noopener noreferrer">
            Timothy Huliselan
          </a>
        </figcaption>
      </figure>
    </div>

    <section class="reading section">
      <div class="prose">
        <h2>What this is</h2>
        <p>
          {siteConfig.name} is a fortnightly letter about the unglamorous parts of running a
          newsletter: the paragraph you cut, the template that renders badly in Outlook, the
          deliverability problem that was really a consent problem, and the readers who quietly
          stopped opening.
        </p>
        <p>
          Every issue is one argument, long enough to be useful and short enough to finish on a
          commute. No sponsor blocks, no link dumps, no sequences designed to warm you up.
        </p>

        <h2>What arrives</h2>
        <ul>
          <li>{siteConfig.cadence}, sent first thing in the morning.</li>
          <li>Occasional interviews with people who have been publishing for years.</li>
          <li>Nothing else. No launch emails, no webinars, no partner offers.</li>
        </ul>

        <h2>Using this theme</h2>
        <p>
          Everything on this site is demo content shipped with the theme. Replace the issues in
          <code>src/content/issues/</code>, set your own details in <code>src/config/site.ts</code>,
          point the signup form at your provider, and the rest follows.
        </p>
      </div>
    </section>

    {
      editor && (
        <section class="reading section--tight" aria-labelledby="editor-title">
          <h2 class="t-h3" id="editor-title" style="margin-bottom:1.25rem">
            {siteConfig.editor.title}
          </h2>
          <a class="writer-card" href={`/writers/${writerSlug(editor.name)}/`}>
            <Avatar name={editor.name} size="lg" />
            <span class="stack" style="gap:0.3rem">
              <span class="t-h4">{editor.name}</span>
              <span class="t-meta">{editor.role}</span>
              <span class="t-small t-dim" style="margin-top:0.35rem">{writerBio(editor.name)}</span>
            </span>
          </a>
        </section>
      )
    }

    <section class="reading section--tight">
      <p class="t-body t-dim">
        Questions, corrections, or a pitch? Write to{" "}
        <a class="link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
      </p>
    </section>

    <div class="container section">
      <SubscribePanel id="about-subscribe" />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .about-figure {
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .about-figure img {
    width: 100%;
    border-radius: var(--r-lg);
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }
</style>
