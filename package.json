{
  "name": "mailer-astro-theme",
  "description": "A newsletter Astro theme: numbered issues, a scannable archive, and a signup form that belongs.",
  "type": "module",
  "version": "1.0.0",
  "author": "Andrei Alba",
  "license": "MIT",
  "private": false,
  "keywords": [
    "astro-theme",
    "astro",
    "newsletter",
    "email",
    "blog",
    "issues",
    "archive",
    "tailwindcss"
  ],
  "homepage": "https://mailer.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/mailer.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.16.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  }
}
